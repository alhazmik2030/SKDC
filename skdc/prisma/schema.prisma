// =====================================================================
// SKDC - Smart Kitchen Design Cloud
// Prisma Schema
// =====================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =====================================================================
// AUTH (NextAuth.js compatible)
// =====================================================================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// =====================================================================
// CORE
// =====================================================================

enum Plan {
  FREE
  PRO
  ENTERPRISE
}

enum Locale {
  AR
  EN
  ZH
}

enum Role {
  OWNER
  ADMIN
  DESIGNER
  VIEWER
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  plan      Plan     @default(FREE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members   Membership[]
  customers Customer[]
  materials Material[]
  templates Template[]
  projects  Project[]
  machines  Machine[]
  apiTokens ApiToken[]
  shipments Shipment[]
  factories      Factory[]
  factoryOrders  FactoryOrder[]
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  locale        Locale    @default(AR)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts    Account[]
  sessions    Session[]
  memberships Membership[]
  apiTokens   ApiToken[]
}

model Membership {
  id          String    @id @default(cuid())
  userId      String
  workspaceId String
  role        Role      @default(DESIGNER)
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
}

// API tokens for programmatic access (MCP, REST, automation).
// Only the SHA-256 hash is stored — plaintext is shown to the user exactly once
// at creation time. `prefix` is the first 8 chars for display ("skdc_xxxxxxxx…").
model ApiToken {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  name        String
  prefix      String
  hash        String    @unique
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([hash])
}

// =====================================================================
// DOMAIN: Customers, Materials, Templates, Projects
// =====================================================================

model Customer {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  phone       String?
  email       String?
  address     String?
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace      Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projects       Project[]
  shipmentItems  ShipmentItem[]

  @@index([workspaceId])
}

enum MaterialType {
  HPL
  POLYLACK
  UVLACK
  MELAMIN
  MDF
  PLYLACK
  WOOD
  GLASS
  OTHER
}

enum DesignStyle {
  MODERN
  CLASSIC
  NEO_CLASSIC
  INDUSTRIAL
  SCANDINAVIAN
}

model Material {
  id          String       @id @default(cuid())
  workspaceId String
  name        String
  type        MaterialType
  color       String?
  thicknessMm Float        @default(18)
  pricePerM2  Float        @default(0)
  // Glass-only metadata
  glassTint   String? // e.g. "clear", "smoked", "bronze", "frosted-milk"
  glassFinish String? // e.g. "transparent", "frosted", "reflective", "tempered"
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  units     Unit[]

  @@index([workspaceId])
}

enum TemplateCategory {
  LOWER_CABINET
  UPPER_CABINET
  CORNER
  TALL_CABINET
  DRAWER
  APPLIANCE
  ACCESSORY
}

// Templates are global by default (workspaceId = null) or workspace-specific
model Template {
  id          String           @id @default(cuid())
  workspaceId String?
  name        String
  category    TemplateCategory
  imageUrl    String?
  // Default dimensions in millimeters
  defaultWidth  Float
  defaultHeight Float
  defaultDepth  Float
  // Configurable options schema (JSON)
  options     Json             @default("{}")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  units     Unit[]

  @@index([workspaceId])
  @@index([category])
}

enum ProjectStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  IN_PRODUCTION
  COMPLETED
  CANCELLED
}

model Project {
  id          String        @id @default(cuid())
  workspaceId String
  customerId  String?
  name        String
  status      ProjectStatus @default(DRAFT)
  designStyle DesignStyle?
  // Room dimensions in millimeters
  roomWidth   Float?
  roomDepth   Float?
  roomHeight  Float?
  notes       String?       @db.Text
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace      Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customer       Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  design         Design?
  invoices       Invoice[]
  machineExports MachineExport[]
  shipmentItems  ShipmentItem[]
  factoryOrders  FactoryOrder[]

  @@index([workspaceId])
  @@index([customerId])
}

// Studio room shape — drives wall auto-generation when a design is initialized.
enum RoomShape {
  SINGLE_WALL    // one wall: A
  L_SHAPE        // two perpendicular walls: A + B
  U_SHAPE        // three walls: A + B + C
  CLOSED         // four walls: A + B + C + D
  ISLAND         // CLOSED + a free island entity
  CUSTOM         // designer added > 4 walls manually
}

// Design holds the actual layout of a project (one-to-one)
model Design {
  id          String     @id @default(cuid())
  projectId   String     @unique
  data        Json       @default("{}") // serialized canvas/3D state (legacy 2D state)
  shape       RoomShape  @default(SINGLE_WALL)
  // Optional island (when shape = ISLAND or designer adds one manually)
  hasIsland   Boolean    @default(false)
  islandWidth Float?     // mm
  islandDepth Float?     // mm
  islandX     Float?     // mm — center X in room space
  islandZ     Float?     // mm — center Z in room space
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  project Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  units   Unit[]
  walls   RoomWall[]
}

/// A wall in the Studio room layout.
/// Naming convention: A (front) → B (right) → C (back) → D (left), clockwise.
/// Openings (window / door) are defined alongside wall geometry in Step 2.
model RoomWall {
  id            String   @id @default(cuid())
  designId      String

  label         String   // "A" | "B" | "C" | "D" (or "أ" "ب" "ج" "د" depending on locale)
  orderIndex    Int      // 0..n following clockwise from A

  // Geometry
  length        Float    // mm
  height        Float    // mm
  thickness     Float    @default(100)

  // Position (computed from shape + previous walls; cached here)
  startX        Float    @default(0)
  startZ        Float    @default(0)
  endX          Float    @default(0)
  endZ          Float    @default(0)
  angleDeg      Float    @default(0)

  // Openings — window
  hasWindow     Boolean  @default(false)
  windowOffset  Float?   // mm from wall start
  windowWidth   Float?   // mm
  windowHeight  Float?   // mm
  windowSill    Float?   // mm from floor

  // Openings — door
  hasDoor       Boolean  @default(false)
  doorOffset    Float?
  doorWidth     Float?
  doorHeight    Float?

  wallMaterial  String?  // e.g. "plaster-white" | "tile-subway-white"

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  design        Design   @relation(fields: [designId], references: [id], onDelete: Cascade)
  units         Unit[]

  @@unique([designId, label])
  @@index([designId])
}

model Unit {
  id         String   @id @default(cuid())
  designId   String
  templateId String?
  materialId String?

  // Wall attachment — null = freestanding / on the island
  wallId     String?
  /// Distance in mm from the wall's start point (a→b direction). Used by
  /// the Assembly step (Step 3) to lay units out along a wall.
  wallOffset Float?

  // Position (mm) in room coordinates (computed from wall + wallOffset when wall-attached)
  x          Float    @default(0)
  y          Float    @default(0)
  z          Float    @default(0)
  // Dimensions (mm) — may override template defaults
  width      Float
  height     Float
  depth      Float
  rotation   Float    @default(0) // degrees around vertical axis
  // Override options (JSON)
  options    Json     @default("{}")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  design   Design    @relation(fields: [designId], references: [id], onDelete: Cascade)
  template Template? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  material Material? @relation(fields: [materialId], references: [id], onDelete: SetNull)
  wall     RoomWall? @relation(fields: [wallId], references: [id], onDelete: SetNull)

  @@index([designId])
  @@index([wallId])
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  CANCELLED
}

model Invoice {
  id          String        @id @default(cuid())
  projectId   String
  number      String        // human-readable, e.g. INV-2026-0001
  status      InvoiceStatus @default(DRAFT)
  subtotal    Float         @default(0)
  discount    Float         @default(0)
  tax         Float         @default(0)
  total       Float         @default(0)
  currency    String        @default("SAR")
  lineItems   Json          @default("[]")
  notes       String?       @db.Text
  issuedAt    DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, number])
  @@index([projectId])
}

// =====================================================================
// UNIVERSAL MACHINE INTEGRATION
// Workshops connect any cutting/drilling/edge-banding machine to SKDC.
// =====================================================================

enum MachineCategory {
  BEAM_SAW
  PANEL_SAW
  CNC_ROUTER
  NESTING_CNC
  EDGE_BANDER
  DRILLING_MACHINE
  BORING_MACHINE
  MEMBRANE_PRESS
  POSTFORMING
  MULTI_FUNCTION
}

enum MachineFormat {
  DXF
  DWG
  GCODE
  WOODWOP_MPR
  BIESSE_BPP
  BIESSE_CIX
  SCM_XXL
  FELDER_PRO
  HOMAG_BHX
  ARDIS_OPTIMIZER
  OPTIMIK
  CSV
  JSON
  PDF_REPORT
}

enum MachineChannel {
  FILE_DOWNLOAD
  FILE_UPLOAD_FTP
  REST_API
  WEBSOCKET
  MQTT
  OPC_UA
  USB_AGENT
}

enum MachineExportStatus {
  PENDING
  READY
  SENT
  FAILED
}

model Machine {
  id              String          @id @default(cuid())
  workspaceId     String
  name            String
  manufacturer    String
  model           String?
  adapterId       String // matches one of MACHINE_REGISTRY ids
  category        MachineCategory
  preferredFormat MachineFormat
  channel         MachineChannel  @default(FILE_DOWNLOAD)

  // Optional connection details for direct channels (FTP, REST, MQTT, etc.)
  endpoint        String? // URL / host
  credentials     Json?   @default("{}") // encrypted at app-level; never expose

  isActive        Boolean  @default(true)
  notes           String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  exports         MachineExport[]

  @@index([workspaceId])
  @@index([adapterId])
}

model MachineExport {
  id          String              @id @default(cuid())
  projectId   String
  machineId   String?
  adapterId   String // archived for traceability even if machine deleted
  format      MachineFormat
  status      MachineExportStatus @default(PENDING)
  fileUrl     String? // R2/S3 location of the generated file
  filename    String
  meta        Json                @default("{}") // adapter-specific metadata
  jobId       String? // tracking id when transmitted to machine directly
  errorMessage String?            @db.Text
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  project Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  machine Machine? @relation(fields: [machineId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([machineId])
  @@index([status])
}

// =====================================================================
// SHIPMENTS
// Workshops import finished cabinet kits from Foshan / Shunde factories.
// Each Shipment is one container/consignment moving CN -> SA; ShipmentItems
// link individual line items back to a Project / Customer for visibility.
// =====================================================================

enum ShipmentStatus {
  PLANNED          // مخططة
  IN_PRODUCTION    // قيد التصنيع في الصين
  READY_TO_SHIP    // جاهزة للشحن
  IN_TRANSIT       // في الطريق
  AT_CUSTOMS       // في الجمارك
  DELIVERED        // وُصلت / مُسلَّمة للورشة
  CANCELLED
}

enum ShipmentMode {
  SEA_FCL          // حاوية بحرية كاملة
  SEA_LCL          // حاوية بحرية مشتركة
  AIR
  ROAD
}

model Shipment {
  id              String          @id @default(cuid())
  workspaceId     String

  // Logistics
  reference       String          // workshop's internal reference, e.g. "SH-2026-001"
  mode            ShipmentMode    @default(SEA_FCL)
  carrier         String?         // "Maersk", "MSC", "DHL", etc.
  trackingNumber  String?         // Bill of Lading / AWB
  containerNumber String?         // ISO 6346 (e.g. "MSKU1234567")

  // Origin / destination
  originFactory   String?         // "Foshan Sunrise Cabinets Co."
  originCity      String?         // "Foshan" / "Shunde" / "Shanghai"
  originCountry   String          @default("CN")
  destPort        String?         // "Jeddah Islamic Port" / "King Abdulaziz Port (Dammam)"
  destCity        String?         // "Riyadh"
  destCountry     String          @default("SA")

  // Status + timeline
  status             ShipmentStatus @default(PLANNED)
  estimatedDeparture DateTime?
  actualDeparture    DateTime?
  estimatedArrival   DateTime?
  actualArrival      DateTime?

  // Money
  totalValue      Float?          // declared shipment value (workshop's cost)
  shippingCost    Float?
  customsDuty     Float?
  currency        String          @default("USD")

  notes           String?         @db.Text
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  workspace       Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  items           ShipmentItem[]

  @@unique([workspaceId, reference])
  @@index([workspaceId])
  @@index([status])
}

model ShipmentItem {
  id          String     @id @default(cuid())
  shipmentId  String
  projectId   String?    // optional — sometimes items are spec'd before a project exists
  customerId  String?    // denormalized for fast queries

  // Item description
  description String     // "خامة HPL أبيض - 25 لوح" or "وحدة سفلية ثلاثة أدراج × 6"
  qty         Int        @default(1)
  unitValue   Float?     // per-unit declared value
  weightKg    Float?
  volumeM3    Float?

  notes       String?    @db.Text
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  shipment    Shipment   @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  project     Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  customer    Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([shipmentId])
  @@index([projectId])
  @@index([customerId])
}

// =====================================================================
// FACTORY PIPELINE
// Chinese (and other) cabinet factories that fulfill workshop orders.
// Each Factory is workspace-scoped and must be VERIFIED before orders flow.
// Every FactoryOrder records a time-stamped event for every status change
// — "حتى التسليم للمصنع يطلع بالوقت واليوم ومضمونها".
// =====================================================================

enum FactoryVerificationStatus {
  UNVERIFIED // factory profile created but not yet submitted for verification
  PENDING // verification submitted, awaiting admin review
  VERIFIED // approved — orders can flow
  REJECTED // rejected (with reason)
  SUSPENDED // temporarily disabled
}

enum FactoryTrustGrade {
  A // 95-100% on-time, no quality issues
  B // 85-94%
  C // 70-84%
  D // <70% — caution
  UNRATED
}

enum FactoryChannel {
  EMAIL
  WHATSAPP
  WECHAT
  DINGTALK
  FTP
  REST_API
  PORTAL // factory logs into SKDC to see orders
}

enum FactoryOrderStatus {
  DRAFT
  SUBMITTED // sent to factory
  ACKNOWLEDGED // factory confirmed receipt
  QUOTED // factory quoted final price
  ACCEPTED // workshop accepted the quote
  IN_PRODUCTION
  QC_PASSED
  READY_TO_SHIP
  SHIPPED // → creates a Shipment automatically
  COMPLETED
  CANCELLED
  DISPUTED
}

model Factory {
  id          String @id @default(cuid())
  workspaceId String // the workshop that "owns" this factory relationship

  // Identity
  name      String // "Foshan Sunrise Cabinets Co., Ltd."
  nameLocal String? // 佛山日升橱柜有限公司
  legalName String?
  taxId     String? // China unified credit code / KSA CR

  // Contact
  contactName      String?
  contactNameLocal String?
  contactPhone     String?
  contactEmail     String?
  wechatId         String?
  whatsappNumber   String?

  // Address
  city        String? // "Foshan"
  province    String? // "Guangdong"
  country     String  @default("CN")
  addressLine String?

  // Capabilities
  preferredFormat MachineFormat  @default(DXF)
  channel         FactoryChannel @default(EMAIL)
  endpoint        String? // URL or address for the channel
  credentials     Json?          @default("{}") // encrypted/sensitive — app-level only

  // Trust + verification
  verificationStatus FactoryVerificationStatus @default(UNVERIFIED)
  verificationNote   String?                   @db.Text // admin's note on approval/rejection
  verifiedAt         DateTime?
  verifiedBy         String? // user.id of the verifier
  trustGrade         FactoryTrustGrade         @default(UNRATED)
  trustScore         Float                     @default(0) // 0.0 - 100.0

  // Operational
  leadTimeDays Int? // typical lead time in days
  paymentTerms String? // "30/70: 30% deposit, 70% before shipping"
  notes        String? @db.Text

  // Performance metrics (auto-computed via cron later)
  totalOrders      Int @default(0)
  onTimeDeliveries Int @default(0)
  qualityIssues    Int @default(0)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  documents FactoryDocument[]
  orders    FactoryOrder[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@index([verificationStatus])
  @@index([trustGrade])
}

model FactoryDocument {
  id         String   @id @default(cuid())
  factoryId  String
  kind       String // "BUSINESS_LICENSE" / "COMMERCIAL_REGISTRATION" / "FACTORY_AUDIT" / "PHOTO" / "OTHER"
  title      String
  fileUrl    String // R2/S3 stored
  fileSize   Int? // bytes
  uploadedBy String // user.id
  uploadedAt DateTime @default(now())

  factory Factory @relation(fields: [factoryId], references: [id], onDelete: Cascade)

  @@index([factoryId])
}

model FactoryOrder {
  id          String @id @default(cuid())
  workspaceId String
  factoryId   String
  projectId   String // the SKDC design being ordered

  // Identifiers
  reference String // workshop's order reference "FO-2026-001"

  status FactoryOrderStatus @default(DRAFT)

  // Money
  factoryQuote    Float? // factory's quoted price
  factoryCurrency String @default("USD") // USD / SAR / CNY
  workshopBudget  Float?
  acceptedAmount  Float? // final agreed price

  // Timeline (each set when the corresponding status is reached)
  submittedAt       DateTime?
  acknowledgedAt    DateTime?
  quotedAt          DateTime?
  acceptedAt        DateTime?
  productionStartAt DateTime?
  qcPassedAt        DateTime?
  readyToShipAt     DateTime?
  shippedAt         DateTime?
  completedAt       DateTime?
  estimatedDelivery DateTime?
  actualDelivery    DateTime?

  // Files generated for the factory (kept across format changes)
  files Json @default("[]") // [{type, format, url, generatedAt}]

  // Optional shipment link (auto-created on SHIPPED status)
  shipmentId String?

  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  factory   Factory             @relation(fields: [factoryId], references: [id], onDelete: Restrict)
  project   Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  events    FactoryOrderEvent[]

  @@unique([workspaceId, reference])
  @@index([workspaceId])
  @@index([factoryId])
  @@index([projectId])
  @@index([status])
}

/**
 * Time-stamped audit log per FactoryOrder.
 * "حتى التسليم للمصنع يطلع بالوقت واليوم ومضمونها" — every status change is recorded
 * with the exact timestamp, who performed it, an optional note, and a snapshot of
 * the items affected.
 */
model FactoryOrderEvent {
  id            String             @id @default(cuid())
  orderId       String
  status        FactoryOrderStatus // status the order moved INTO
  occurredAt    DateTime           @default(now())
  actorUserId   String? // null = factory-side (their portal/API)
  actorLabel    String? // "Mr. Wang (factory)" if non-user
  note          String?            @db.Text
  itemsSnapshot Json?              @default("[]") // [{description, qty, ...}] frozen at this moment
  attachmentUrl String? // optional photo / pdf

  order FactoryOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([occurredAt])
}
