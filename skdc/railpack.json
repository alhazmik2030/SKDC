{
  "$schema": "https://schema.railpack.com",
  "provider": "node",
  "buildAptPackages": [],
  "steps": {
    "install": {
      "commands": [
        "npm install --no-audit --no-fund --legacy-peer-deps"
      ]
    },
    "build": {
      "commands": [
        "npm run build"
      ]
    }
  },
  "deploy": {
    "startCommand": "npm run start"
  }
}
